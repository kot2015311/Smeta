# Скопируйте файл в .env и заполните. Сам .env в репозиторий не загружайте.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAA_замените_на_свой_токен

# Куда присылать заявки: id чата или группы (как узнать — в README)
TELEGRAM_CHAT_ID=-1001234567890

# Адрес сайта, с которого разрешено отправлять заявки (через запятую, без / в конце)
ALLOWED_ORIGINS=https://username.github.io

# Сколько заявок можно отправить с одного адреса за RATE_WINDOW секунд
RATE_LIMIT=5
RATE_WINDOW=600

# 1 — если сервер стоит за nginx или другим прокси
TRUST_PROXY=0
